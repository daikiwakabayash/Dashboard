# Square API Configuration
# Vercelの環境変数に設定してください

# ─────────────────────────────────────
# 方法1: 単一アカウント（後方互換）
# ─────────────────────────────────────
# SQUARE_ACCESS_TOKEN=sq_live_xxxxx
# SQUARE_ENVIRONMENT=production
# SQUARE_LOCATION_ID=LLLLLLLLLLLLLLLLLLLL

# ─────────────────────────────────────
# 方法2: 複数アカウント（75店舗対応・推奨）
# ─────────────────────────────────────
# SQUARE_TOKENS に全アカウントのトークンをJSON配列で設定
# 各エントリ:
#   name: 店舗表示名
#   token: Square APIアクセストークン
#   env: "production" or "sandbox"
#   excludeLocations: 除外するロケーション名パターン（任意）
#
# 例:
# SQUARE_TOKENS=[{"name":"恵比寿院","token":"sq_live_xxx","env":"production","excludeLocations":["株式会社SSiM"]},{"name":"千葉駅院","token":"sq_live_yyy","env":"production"},{"name":"池尻大橋院","token":"sq_live_aaa","env":"production"},{"name":"関内院","token":"sq_live_bbb","env":"production"},{"name":"溝の口院","token":"sq_live_ccc","env":"production"},{"name":"上大岡院","token":"sq_live_ddd","env":"production"},{"name":"山形天童院","token":"sq_live_eee","env":"production"},{"name":"山形院","token":"sq_live_fff","env":"production"}]
