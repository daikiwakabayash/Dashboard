# Square API Configuration
# Vercelの環境変数に設定してください

# Square Access Token (本番用)
# Square Developer Dashboard > Production > Access Token から取得
SQUARE_ACCESS_TOKEN=your_production_access_token_here

# Square Environment: sandbox or production
SQUARE_ENVIRONMENT=production

# 本番の店舗のSquare Location ID
# Square Developer Dashboard > Locations から取得
SQUARE_LOCATION_ID=your_production_location_id_here
