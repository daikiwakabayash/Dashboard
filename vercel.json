{
  "functions": {
    "api/auth.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/gas-proxy.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/chat.js": {
      "memory": 512,
      "maxDuration": 120
    },
    "api/square/metrics.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/square/test.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/health.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/finance-chat.js": {
      "memory": 512,
      "maxDuration": 120
    },
    "api/finance-pdf.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/square/settlement.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/settlement-store.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/settlement-auth.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/settlement-owners.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/square/metrics",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=120" }
      ]
    },
    {
      "source": "/api/settlement-(store|auth|owners)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
