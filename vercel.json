{
  "buildCommand": "node scripts/precompile.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/auth.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/chat.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/health.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/plan-store.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/settlement.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/square.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/finance.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/gas.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/plan-store?type=meo&action=cronscan", "schedule": "0 20 * * *" }
  ],
  "rewrites": [
    { "source": "/api/settlement-auth", "destination": "/api/settlement?fn=auth" },
    { "source": "/api/settlement-owners", "destination": "/api/settlement?fn=owners" },
    { "source": "/api/settlement-store", "destination": "/api/settlement?fn=store" },
    { "source": "/api/square/metrics", "destination": "/api/square?fn=metrics" },
    { "source": "/api/square/settlement", "destination": "/api/square?fn=settlement" },
    { "source": "/api/square/test", "destination": "/api/square?fn=test" },
    { "source": "/api/finance-chat", "destination": "/api/finance?fn=chat" },
    { "source": "/api/finance-pdf", "destination": "/api/finance?fn=pdf" },
    { "source": "/api/customers", "destination": "/api/gas?fn=customers" },
    { "source": "/api/gas-proxy", "destination": "/api/gas?fn=proxy" }
  ],
  "headers": [
    {
      "source": "/api/square/metrics",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=120" }
      ]
    },
    {
      "source": "/api/settlement-(store|auth|owners)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/plan-store(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(index.html|owner.html|sw.js|manifest.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
